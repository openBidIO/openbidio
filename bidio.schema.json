{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bidio.dev/schema/0.1/bidio.schema.json",
  "title": "bidIO bid document, v0.1 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["bidio", "id", "project", "currency", "shots", "totals"],
  "properties": {
    "bidio": { "type": "string", "pattern": "^0\\.1(\\.\\d+)?$" },
    "id": { "type": "string", "format": "uuid" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "client": { "type": "string" }
      }
    },
    "parties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": { "$ref": "#/$defs/party" },
        "client": { "$ref": "#/$defs/party" }
      }
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "fx_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["currency", "rate"],
        "properties": {
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "rate": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
          "key": { "$ref": "#/$defs/deptKey" },
          "label": { "type": "string" }
        }
      }
    },
    "shot_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "rate_card": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "type": "number", "minimum": 0 }
      }
    },
    "shots": {
      "type": "array",
      "items": { "$ref": "#/$defs/shot" }
    },
    "line_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/lineItem" }
    },
    "incentives": {
      "type": "array",
      "items": { "$ref": "#/$defs/incentive" }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gross", "incentive_credit", "net"],
      "properties": {
        "shots_subtotal": { "type": "number" },
        "line_items_subtotal": { "type": "number" },
        "gross": { "type": "number" },
        "incentive_credit": { "type": "number" },
        "net": { "type": "number" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "locked": { "type": "boolean" },
        "supersedes": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "award": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["draft", "submitted", "awarded", "declined", "withdrawn"] },
        "submitted_at": { "type": "string", "format": "date-time" },
        "awarded_at": { "type": "string", "format": "date-time" },
        "client_reference": { "type": "string" }
      }
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "deptKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
      "additionalProperties": { "type": "object" }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "sequence": { "type": "string" },
        "type": { "type": "string" },
        "difficulty": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "quantity": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "frames": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "in": { "type": "integer" },
            "out": { "type": "integer" }
          }
        },
        "efforts": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": { "type": "number", "minimum": 0 }
          }
        },
        "unit_price": { "type": ["number", "null"], "minimum": 0 },
        "notes": { "type": "string" },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "quantity", "unit_cost"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "quantity": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" },
        "unit_cost": { "type": "number", "minimum": 0 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "incentive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdiction", "labour_share", "labour_rate", "nonlabour_rate"],
      "properties": {
        "jurisdiction": { "type": "string", "minLength": 2 },
        "program": { "type": "string" },
        "labour_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "labour_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "nonlabour_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    }
  }
}
