{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbidio.github.io/openbidio/schema/0.5/openbidio.schema.json",
  "title": "OpenBidIO bid document, v0.5 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bidio",
    "id",
    "conformance",
    "project",
    "currency",
    "shots",
    "totals",
    "digest"
  ],
  "properties": {
    "bidio": {
      "type": "string",
      "pattern": "^0\\.5(\\.\\d+)?$"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "bid_id": {
      "type": "string",
      "format": "uuid"
    },
    "conformance": {
      "enum": [
        "M1",
        "M1-Multisite",
        "M1-Series",
        "M1-Vendors",
        "M1-Full"
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "parties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "$ref": "#/$defs/party"
        },
        "client": {
          "$ref": "#/$defs/party"
        },
        "vendors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vendor"
          }
        }
      }
    },
    "currency": {
      "$ref": "#/$defs/currency"
    },
    "fx_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "rate"
        ],
        "properties": {
          "currency": {
            "$ref": "#/$defs/currency"
          },
          "rate": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "jurisdiction"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/siteKey"
          },
          "label": {
            "type": "string"
          },
          "jurisdiction": {
            "$ref": "#/$defs/jurisdiction"
          },
          "currency": {
            "$ref": "#/$defs/currency"
          },
          "rate_card": {
            "$ref": "#/$defs/rateCard"
          }
        }
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "#/$defs/episodeCode"
          },
          "title": {
            "type": "string"
          },
          "frames": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/deptKey"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "shot_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "rate_card": {
      "$ref": "#/$defs/rateCard"
    },
    "overheads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "rate"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "rate": {
            "$ref": "#/$defs/fraction"
          },
          "extensions": {
            "$ref": "#/$defs/extensions"
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lineItem"
      }
    },
    "incentives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/incentive"
      }
    },
    "subbids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subbid"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "uri"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gross",
        "incentive_credit",
        "net"
      ],
      "properties": {
        "shots_subtotal": {
          "$ref": "#/$defs/money"
        },
        "line_items_subtotal": {
          "$ref": "#/$defs/money"
        },
        "discount_total": {
          "$ref": "#/$defs/money"
        },
        "overhead_total": {
          "$ref": "#/$defs/money"
        },
        "gross": {
          "$ref": "#/$defs/money"
        },
        "incentive_credit": {
          "$ref": "#/$defs/money"
        },
        "net": {
          "$ref": "#/$defs/money"
        },
        "by_site": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_-]*$": {
              "$ref": "#/$defs/totalsBlock"
            }
          }
        },
        "by_episode": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_-]*$": {
              "$ref": "#/$defs/totalsBlock"
            }
          }
        },
        "by_vendor": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_-]*$": {
              "$ref": "#/$defs/totalsBlock"
            }
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "locked": {
          "type": "boolean"
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "in_response_to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bid_id",
        "revision"
      ],
      "properties": {
        "bid_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "number"
          ],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "variant": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "award": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "submitted",
            "awarded",
            "declined",
            "withdrawn"
          ]
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "awarded_at": {
          "type": "string",
          "format": "date-time"
        },
        "client_reference": {
          "type": "string"
        }
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "if": {
    "required": [
      "revision"
    ],
    "properties": {
      "revision": {
        "required": [
          "variant"
        ]
      }
    }
  },
  "then": {
    "required": [
      "bid_id"
    ]
  },
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "description": "A decimal amount written as a string, so no reader ever rounds it through a binary float. Units of the document currency unless the item is tagged to a site that declares its own currency (SPEC 2.2)."
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$",
      "description": "ISO 3166-1 alpha-2 country, optionally with its ISO 3166-2 subdivision: CA-QC, GB-ENG, US-NY, NZ."
    },
    "deptKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "siteKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "vendorKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "episodeCode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "rateCard": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "role"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/vendorKey"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "prime",
            "sub"
          ]
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "rate_card": {
          "$ref": "#/$defs/rateCard"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "generated_by": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system": {
              "type": "string"
            },
            "ref": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            }
          }
        }
      }
    },
    "subbid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "bid_id",
        "revision",
        "digest",
        "document"
      ],
      "properties": {
        "vendor": {
          "$ref": "#/$defs/vendorKey"
        },
        "bid_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "number"
          ],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "variant": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "document": {
          "$ref": "#"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "totalsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gross",
        "incentive_credit",
        "net"
      ],
      "properties": {
        "shots_subtotal": {
          "$ref": "#/$defs/money"
        },
        "line_items_subtotal": {
          "$ref": "#/$defs/money"
        },
        "gross": {
          "$ref": "#/$defs/money"
        },
        "incentive_credit": {
          "$ref": "#/$defs/money"
        },
        "net": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "sequence": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "difficulty": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "execution_site": {
          "$ref": "#/$defs/siteKey"
        },
        "episode": {
          "$ref": "#/$defs/episodeCode"
        },
        "vendor": {
          "$ref": "#/$defs/vendorKey"
        },
        "frames": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "in": {
              "type": "integer"
            },
            "out": {
              "type": "integer"
            }
          }
        },
        "efforts": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "unit_price": {
          "oneOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "discount": {
          "$ref": "#/$defs/fraction"
        },
        "labour_share": {
          "$ref": "#/$defs/fraction"
        },
        "notes": {
          "type": "string"
        },
        "assumptions": {
          "type": "string"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "quantity",
        "unit_cost"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "quantity": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "unit_cost": {
          "$ref": "#/$defs/money"
        },
        "discount": {
          "$ref": "#/$defs/fraction"
        },
        "labour_share": {
          "$ref": "#/$defs/fraction"
        },
        "execution_site": {
          "$ref": "#/$defs/siteKey"
        },
        "episode": {
          "$ref": "#/$defs/episodeCode"
        },
        "vendor": {
          "$ref": "#/$defs/vendorKey"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "incentive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "labour_share",
        "labour_rate",
        "nonlabour_rate"
      ],
      "properties": {
        "jurisdiction": {
          "$ref": "#/$defs/jurisdiction"
        },
        "program": {
          "type": "string"
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/siteKey"
          },
          "minItems": 1
        },
        "labour_share": {
          "$ref": "#/$defs/fraction"
        },
        "labour_rate": {
          "$ref": "#/$defs/fraction"
        },
        "nonlabour_rate": {
          "$ref": "#/$defs/fraction"
        },
        "basis": {
          "enum": [
            "cost",
            "labour"
          ],
          "default": "cost"
        },
        "cap": {
          "$ref": "#/$defs/money"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
